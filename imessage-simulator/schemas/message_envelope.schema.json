{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vg-capstone/schemas/message_envelope/0.1",
  "title": "MessageEnvelope v0.1",
  "description": "One inbound message from any channel (iMessage, Gmail, ...), normalized for the agent and MCP tools. The channel reports facts; VG's IAM decides roles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version", "message_id", "correlation_id", "channel",
    "channel_message_id", "conversation", "sender", "principal_id",
    "text", "attachments", "in_reply_to", "flags", "sent_at", "received_at"
  ],
  "properties": {
    "envelope_version": { "const": "0.1" },
    "message_id": { "type": "string", "pattern": "^msg_[A-Za-z0-9]+$" },
    "correlation_id": { "type": "string", "pattern": "^corr_[A-Za-z0-9]+$" },
    "channel": { "enum": ["imessage", "gmail"] },
    "channel_message_id": { "type": "string", "minLength": 1 },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation_id", "type", "reply_target"],
      "properties": {
        "conversation_id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["direct", "group"] },
        "reply_target": { "type": "string", "minLength": 1 }
      }
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "handle_type", "actor_id", "actor_role"],
      "properties": {
        "handle": { "type": "string", "minLength": 1 },
        "handle_type": { "enum": ["phone", "email"] },
        "actor_id": { "type": ["string", "null"] },
        "actor_role": { "enum": ["unresolved", "principal", "delegate", "colleague", "external"] }
      }
    },
    "principal_id": { "type": "string", "minLength": 1 },
    "text": { "type": "string" },
    "attachments": {
      "type": "array",
      "items": { "$ref": "#/$defs/attachment" }
    },
    "in_reply_to": { "type": ["string", "null"] },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_from_assistant", "is_group"],
      "properties": {
        "is_from_assistant": { "type": "boolean" },
        "is_group": { "type": "boolean" }
      }
    },
    "sent_at": { "type": "string", "format": "date-time" },
    "received_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachment_id", "filename", "media_type", "size_bytes", "sha256",
        "content_ref", "validation", "reject_reason", "redaction_status"
      ],
      "properties": {
        "attachment_id": { "type": "string", "pattern": "^att_[A-Za-z0-9]+$" },
        "filename": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "content_ref": { "type": ["string", "null"] },
        "validation": { "enum": ["accepted", "rejected"] },
        "reject_reason": { "enum": [null, "unsupported_type", "too_large"] },
        "redaction_status": { "enum": ["pending", "redacted", "not_required", "skipped"] }
      }
    }
  }
}
